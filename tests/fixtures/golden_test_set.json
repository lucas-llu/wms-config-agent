{
  "schema_version": 1,
  "name": "public-sanitized-smoke-v1",
  "description": "Sanitized process-code retrieval checks for the local WMS corpus.",
  "thresholds": {
    "hit_at_3_min": 1.0,
    "hit_at_5_min": 1.0,
    "mrr_at_5_min": 0.75,
    "evidence_accuracy_min": 1.0,
    "p95_latency_ms_max": 2000
  },
  "test_cases": [
    {
      "id": "public-inbound-putaway-code",
